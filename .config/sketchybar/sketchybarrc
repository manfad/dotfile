##### Adding Right Items #####
# In the same way as the left items we can add items to the right side.
# Additional position (e.g. center) are available, see:
# https://felixkratz.github.io/SketchyBar/config/items#adding-items-to-sketchybar

# Some items refresh on a fixed cycle, e.g. the clock runs its script once
# every 10s. Other items respond to events they subscribe to, e.g. the
# volume.sh script is only executed once an actual change in system audio
# volume is registered. More info about the event system can be found here:
# https://felixkratz.github.io/SketchyBar/config/events


# --- Right Side: Battery, Volume, Wifi, Date ---
# --- Right Side Items (Order matters: first added is furthest right) ---
# --- 3. Media Player (Right Side) ---

#Time
sketchybar --add item time right \
           --set time update_freq=30 \
                 script="$HOME/.config/sketchybar/plugins/clock.sh" \
                  icon.padding_left=6 \
                 icon.padding_right=6 \
                 padding_left=4 \
                 padding_right=4
# Date (your custom one)
sketchybar --add item date right \
           --set date update_freq=30 \
                 script="$HOME/.config/sketchybar/plugins/date.sh" \
                  icon.padding_left=6 \
                 icon.padding_right=6 \
                 padding_left=4 \
                 padding_right=4

# Battery (you already have battery.sh – keep using it)
sketchybar --add item battery right \
           --set battery script="$HOME/.config/sketchybar/plugins/battery.sh" \
                 update_freq=120 \
                 icon.padding_left=4\
                  icon.padding_right=4 \
                                   label.padding_right=4 \
                 --subscribe battery power_source_change system_woke

# Audio (headset vs built-in)
sketchybar --add item audio right \
           --set audio update_freq=5 \
                 script="$HOME/.config/sketchybar/plugins/audio.sh" \
                 icon.font="SF Pro Display:Semibold:13.0" \
                 icon.padding_left=4 \
                 icon.padding_right=2 \
                 label.drawing=on \
                 label.padding_left=2 \
                 label.padding_right=6 \
                 --subscribe audio volume_change

# WiFi
sketchybar --add item wifi right\
           --set wifi update_freq=10 \
                 script="$HOME/.config/sketchybar/plugins/wifi.sh" \
                 icon.font="SF Pro Display:Semibold:13.0" \
                 icon.padding_left=4 \
                 icon.padding_right=4 \
                 label.drawing=off

# VPN
sketchybar --add item vpn right \
           --set vpn update_freq=5 \
                 script="$HOME/.config/sketchybar/plugins/vpn.sh" \
                 icon.font="SF Pro Display:Semibold:16.0" \
                 icon.padding_left=4 \
                 icon.padding_right=4 \
                 label.drawing=off

# Keyboard layout (Hardcoded Square)
sketchybar --add item keyboard right \
           --set keyboard update_freq=3 \
                 icon.drawing=off \
                 label.drawing=on \
                 label.font="SF Pro Display:Bold:14.0" \
                 label.padding_left=8 \
                 label.padding_right=8 \
                 label.color=0xff1d1d1f \
                 label.y_offset=0 \
                 padding_left=4 \
                 padding_right=4 \
                 background.drawing=on \
                 background.height=24 \
                 background.corner_radius=5 \
                 background.color=0xffe0e0e0 \
                 background.border_width=0 \
                 script="$HOME/.config/sketchybar/plugins/keyboard.sh"
# Media Player (Right Side)
sketchybar --add item nowplaying right \
           --set nowplaying \
                 update_freq=1 \
                 icon.font="sketchybar-app-font:Regular:16.0" \
                 icon.padding_left=8 \
                 icon.padding_right=4 \
                 label.font="SF Pro:Regular:12.0" \
                 label.padding_left=4 \
                 label.padding_right=8 \
                 label.max_chars=15 \
                 scroll_texts=on \
                 background.drawing=on \
                 background.color=0x44ffffff \
                 background.corner_radius=8 \
                 background.height=26 \
                 padding_right=10 \
                 drawing=off \
                 script="$HOME/.config/sketchybar/plugins/media.sh"
## Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
